# Database (Supabase PostgreSQL)
# Pooled connection (port 6543) used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base domain for tenant subdomains (e.g. school.vidatech.com)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
