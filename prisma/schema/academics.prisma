model SchoolClass {
  studentAttendanceRecords StudentAttendance[]
  conductRecordList        ConductRecord[]
  feeStructureList         FeeStructure[]
  invoiceList              Invoice[]
  assessmentList           Assessment[]
  broadcastMessages        Message[]
  timetableLessonList      TimetableLesson[]
  id                       String              @id @default(cuid())
  schoolId                 String              @map("school_id")
  school                   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  stage     EducationStage
  sortOrder Int            @default(0) @map("sort_order")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  streams     Stream[]
  assignments TeacherAssignment[]
  enrollments StudentEnrollment[]

  @@unique([schoolId, name])
  @@index([schoolId, stage])
  @@map("classes")
}

model Stream {
  assessmentList      Assessment[]
  timetableLessonList TimetableLesson[]
  id                  String            @id @default(cuid())
  schoolId            String            @map("school_id")
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId String      @map("class_id")
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name    String

  createdAt DateTime @default(now())

  assignments TeacherAssignment[]
  enrollments StudentEnrollment[]

  @@unique([classId, name])
  @@index([schoolId, classId])
  @@map("streams")
}

model Subject {
  gradingScaleList    GradingScale[]
  assessmentList      Assessment[]
  timetableLessonList TimetableLesson[]
  id                  String            @id @default(cuid())
  schoolId            String            @map("school_id")
  school              School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name  String
  code  String?
  stage EducationStage

  createdAt DateTime @default(now())

  assignments TeacherAssignment[]

  @@unique([schoolId, stage, name])
  @@index([schoolId, stage])
  @@map("subjects")
}

model TeacherAssignment {
  id       String @id @default(cuid())
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String      @map("teacher_id")
  teacher   User        @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String      @map("subject_id")
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classId   String      @map("class_id")
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  streamId  String?     @map("stream_id")
  stream    Stream?     @relation(fields: [streamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([schoolId, teacherId])
  @@index([schoolId, classId])
  @@map("teacher_assignments")
}

model StudentEnrollment {
  id       String @id @default(cuid())
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId String      @map("student_id")
  student   User        @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  classId   String      @map("class_id")
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  streamId  String?     @map("stream_id")
  stream    Stream?     @relation(fields: [streamId], references: [id], onDelete: SetNull)

  isCurrent    Boolean @default(true) @map("is_current")
  academicYear Int     @map("academic_year")

  createdAt DateTime @default(now())

  @@index([schoolId, studentId, isCurrent])
  @@index([schoolId, classId, isCurrent])
  @@map("student_enrollments")
}
